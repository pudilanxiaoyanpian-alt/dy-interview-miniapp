.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 72rpx;
  background: #f6f7f9;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  display: block;
  color: #171717;
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
}

.section {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  color: #171717;
  font-size: 30rpx;
  font-weight: 800;
}

.section-body {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
}
