.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 72rpx;
  background: #f6f7f9;
}

.summary {
  padding: 36rpx 0 28rpx;
}

.eyebrow {
  display: block;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #171717;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
  margin: 38rpx auto 28rpx;
  border-radius: 50%;
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(37, 99, 235, 0.24);
}

.score {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.score-label {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.summary-text {
  display: block;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.65;
  text-align: center;
}

.section {
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  margin-bottom: 24rpx;
  color: #171717;
  font-size: 32rpx;
  font-weight: 800;
}

.dimension {
  padding: 22rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.dimension:first-of-type {
  border-top: 0;
}

.dimension-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dimension-name {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
}

.dimension-value {
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 800;
}

.bar {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #2563eb;
}

.dimension-note {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

.action {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
}

.action-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.action-text {
  color: #334155;
  font-size: 26rpx;
  line-height: 1.55;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.primary,
.secondary {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary {
  background: #2563eb;
  color: #ffffff;
}

.secondary {
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  color: #334155;
}
