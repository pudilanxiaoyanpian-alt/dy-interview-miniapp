<view class="page">
  <view class="header">
    <text class="title">隐私政策</text>
    <text class="subtitle">更新日期：{{updatedAt}}</text>
  </view>

  <view class="section" tt:for="{{sections}}" tt:key="title">
    <text class="section-title">{{item.title}}</text>
    <text class="section-body">{{item.body}}</text>
  </view>
</view>
