.page {
  min-height: 100vh;
  background: #fafafa;
}

.nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #e5e5e5;
  background: rgba(255, 255, 255, 0.94);
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 16rpx;
}

.logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.brand-name {
  color: #171717;
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
}

.nav-action {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #171717;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  flex: 0 0 auto;
}

.hero-section {
  padding: 96rpx 32rpx 72rpx;
  text-align: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 56rpx;
  margin-bottom: 48rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
  gap: 14rpx;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2563eb;
  flex: 0 0 auto;
}

.badge-separator {
  width: 1rpx;
  height: 28rpx;
  background: #bfdbfe;
}

.badge-highlight {
  color: #d97706;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-line {
  display: block;
  color: #171717;
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1.16;
}

.title-highlight {
  color: #2563eb;
}

.description {
  display: block;
  margin: 40rpx auto 0;
  max-width: 650rpx;
  color: #525252;
  font-size: 30rpx;
  line-height: 1.72;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 56rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.primary-button {
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(37, 99, 235, 0.22);
  gap: 12rpx;
}

.secondary-button {
  border: 1rpx solid #e5e5e5;
  background: #ffffff;
  color: #404040;
}

.arrow {
  font-size: 34rpx;
  line-height: 1;
}

.features-section {
  padding: 48rpx 32rpx 96rpx;
}

.section-head {
  margin-bottom: 44rpx;
  text-align: center;
}

.section-title {
  display: block;
  color: #171717;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
}

.section-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #737373;
  font-size: 28rpx;
  line-height: 1.5;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-card {
  padding: 36rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.feature-icon.indigo {
  background: #e0e7ff;
  color: #4f46e5;
}

.feature-icon.purple {
  background: #f3e8ff;
  color: #9333ea;
}

.feature-icon.blue {
  background: #dbeafe;
  color: #2563eb;
}

.feature-icon.green {
  background: #d1fae5;
  color: #059669;
}

.feature-title {
  display: block;
  color: #171717;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.feature-description {
  display: block;
  margin-top: 14rpx;
  color: #737373;
  font-size: 26rpx;
  line-height: 1.7;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 48rpx 32rpx 56rpx;
  border-top: 1rpx solid #e5e5e5;
  background: #ffffff;
  text-align: center;
}

.footer-brand {
  display: flex;
  align-items: center;
  color: #171717;
  font-size: 26rpx;
  font-weight: 800;
  gap: 12rpx;
}

.footer-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 28rpx;
}

.footer-link {
  min-width: auto;
  height: 44rpx;
  color: #737373;
  font-size: 24rpx;
  line-height: 44rpx;
}

.copyright {
  color: #a3a3a3;
  font-size: 22rpx;
  line-height: 1.55;
}
