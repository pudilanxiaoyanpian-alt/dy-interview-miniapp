<view class="page">
  <view class="header">
    <text class="title">常见问题</text>
    <text class="subtitle">上线前自测和用户说明所需的基础问答</text>
  </view>

  <view class="faq" tt:for="{{faqs}}" tt:key="question">
    <text class="question">{{item.question}}</text>
    <text class="answer">{{item.answer}}</text>
  </view>
</view>
