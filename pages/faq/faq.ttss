.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f6f7f9;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  display: block;
  color: #171717;
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 27rpx;
}

.faq {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.question {
  display: block;
  color: #171717;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.answer {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.65;
}
