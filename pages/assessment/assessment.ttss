.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 72rpx;
  background: #f6f7f9;
}

.hero {
  padding: 16rpx 0 34rpx;
}

.eyebrow {
  display: block;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #171717;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #666f7b;
  font-size: 28rpx;
  line-height: 1.65;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.field {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  color: #252b36;
  font-size: 28rpx;
  font-weight: 700;
}

.required::after {
  content: " *";
  color: #dc2626;
}

.input,
.textarea {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #111827;
  font-size: 28rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
}

.textarea {
  min-height: 230rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.chip {
  height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 64rpx;
}

.chip-active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 700;
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 6rpx 0 32rpx;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.checkbox-on {
  border-color: #2563eb;
  background: #2563eb;
}

.consent-text {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.55;
}

.link {
  color: #2563eb;
}

.submit {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 92rpx;
}
